# microCMS (endpoint: blogs)
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=
# Secret set on the microCMS webhook (app/api/revalidate/route.ts)
MICROCMS_WEBHOOK_SECRET=

# Contact form (Server Action: app/actions/contact.ts)
CONTACT_TO_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# reCAPTCHA v3 (optional — verification is skipped when unset)
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
